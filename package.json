{
  "name": "lrnr",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check:env": "tsx scripts/check-env.ts",
    "eval:phase1": "vitest run tests/evals/phase1-eval.test.ts",
    "smoke:phase1": "tsx scripts/smoke-test-phase-1.ts",
    "deploy:check": "tsx scripts/deployment-readiness-check.ts",
    "daily:run": "tsx scripts/run-daily-learning.ts",
    "outbox:process": "tsx scripts/process-delivery-outbox.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:status": "tsx scripts/db-status.ts"
  },
  "dependencies": {
    "@mobasshirkhan/docguard": "^0.1.1-beta.2",
    "drizzle-orm": "^0.44.2",
    "ioredis": "^5.8.2",
    "morgan": "^1.10.1",
    "next": "^15.5.6",
    "next-auth": "^5.0.0-beta.29",
    "p-limit": "^7.1.1",
    "p-retry": "^7.0.0",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "telegraf": "^4.16.3",
    "winston": "^3.18.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.6",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "drizzle-kit": "^0.31.4"
  }
}
