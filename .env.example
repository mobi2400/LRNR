# Core app runtime
NODE_ENV=development
APP_URL=http://localhost:3000
ACCESS_MODE=owner_only

# Owner-only access
OWNER_USER_ID=
OWNER_EMAIL=
AUTH_SECRET=
LRNR_ACCESS_SECRET_HASH=
LRNR_ACCESS_SECRET_SALT=

# Database and cache
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
REDIS_URL=

# AI providers
LLM_API_KEY=
EMBEDDING_API_KEY=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Optional ElevenLabs voice support
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional client-safe mirrors.
# Keep these aligned with the server values if you expose them later.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ACCESS_MODE=owner_only
NEXT_PUBLIC_ELEVENLABS_ENABLED=false
